{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/account.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/productos", "destination": "/productos.html" },
    { "source": "/servicios", "destination": "/servicios.html" },
    { "source": "/carrito", "destination": "/carrito.html" },
    { "source": "/cuenta", "destination": "/cuenta.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/cobro", "destination": "/cobro.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
